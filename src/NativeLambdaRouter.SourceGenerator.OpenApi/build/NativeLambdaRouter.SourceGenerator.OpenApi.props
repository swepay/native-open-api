<Project>
  <ItemGroup>
    <!-- Original properties (pre-Wave-1) -->
    <CompilerVisibleProperty Include="OpenApiSpecName" />
    <CompilerVisibleProperty Include="OpenApiSpecTitle" />

    <!--
      RFC-DOCUMENTACAO-UX Wave 1 — renderer-facing properties.
      These are read by the consumer host at runtime (via IConfiguration or a
      strongly-typed options binder), not by the Source Generator. They are
      exposed as CompilerVisibleProperty so that a future generator version
      can embed them as constants into the generated spec provider when
      air-gapped deployments require it.
    -->

    <!-- F15 — Branding -->
    <CompilerVisibleProperty Include="OpenApiBrandPrimaryColor" />
    <CompilerVisibleProperty Include="OpenApiBrandAccentColor" />
    <CompilerVisibleProperty Include="OpenApiBrandLogoUrl" />
    <CompilerVisibleProperty Include="OpenApiBrandFavicon" />
    <CompilerVisibleProperty Include="OpenApiBrandFontFamily" />
    <CompilerVisibleProperty Include="OpenApiBrandThemeJson" />

    <!-- F16 — Footer -->
    <CompilerVisibleProperty Include="OpenApiFooterStatusUrl" />
    <CompilerVisibleProperty Include="OpenApiFooterSupportUrl" />
    <CompilerVisibleProperty Include="OpenApiFooterChangelogUrl" />
    <CompilerVisibleProperty Include="OpenApiFooterSlaUrl" />
    <CompilerVisibleProperty Include="OpenApiFooterTermsUrl" />

    <!-- F17 — Renderer behaviour / air-gap -->
    <CompilerVisibleProperty Include="OpenApiInlineAssets" />
    <CompilerVisibleProperty Include="OpenApiEnableMermaid" />

    <!-- F19 (backlog, prop reserved for forward-compat) — Servers -->
    <CompilerVisibleProperty Include="OpenApiServerProduction" />
    <CompilerVisibleProperty Include="OpenApiServerSandbox" />

    <!-- F02 (wave 3, prop reserved for forward-compat) — default audience filter -->
    <CompilerVisibleProperty Include="OpenApiDefaultAudience" />

    <!--
      Merge-architecture opt-out.
      Set to 'false' in producer projects that participate in a multi-spec merge so that
      components/responses (BadRequest/Unauthorized/InternalServerError) and
      components/securitySchemes (JwtBearer) are NOT emitted by each producer.
      Those definitions are expected to come from the shared 'common' files consumed by
      the merger. The $refs inside operations are preserved regardless of this flag.
      Default: true (standalone projects always emit the standard components).
    -->
    <CompilerVisibleProperty Include="OpenApiEmitStandardComponents" />
  </ItemGroup>
</Project>
